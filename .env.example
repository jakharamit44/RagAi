# ==============================================================================
# Enterprise University RAG System - Environment Configuration
# Reference: Appendix C (Configuration Reference) of Technical Plan
# ==============================================================================

# Core & Auth (Phase 6, 11, 19)
API_KEY=change-this-to-a-secure-random-api-key-for-internal-services
JWT_SIGNING_KEY=change-this-to-a-secure-random-secret-key-for-jwt-tokens
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Database & Storage (Phase 1, 3, 7)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/university_rag
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333
VECTOR_COLLECTION_NAME=university_corpus
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
REDIS_URL=redis://localhost:6379/0

# Folder Watcher & Ingestion (Phase 1, 8, 19)
WATCHED_FOLDERS=
RESCAN_INTERVAL_SECONDS=900
MAX_CONCURRENT_INGESTION_JOBS=10
MAX_UPLOAD_SIZE_MB=100

# LLM Router (Phase 5)
OLLAMA_HOST=http://localhost:11434
VLLM_ENDPOINT=http://localhost:8000/v1
CHAT_MODEL_ALIAS=university-chat
ENABLE_HOSTED_FALLBACK=false
HOSTED_API_BASE=
HOSTED_API_KEY=
HOSTED_API_MODEL=
GPU_AUTODETECT=true

# Embedding & Reranking Models (Phase 3, 4)
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B

# Retrieval (Phase 4)
TOP_K_RETRIEVE=20
TOP_K_FINAL=5

# Caching, Rate Limits & Abuse Prevention (Phase 7, 19)
CACHE_TTL_VOLATILE_SECONDS=3600
CACHE_TTL_STABLE_SECONDS=86400
RATE_LIMIT_PER_STUDENT_PER_MINUTE=20
RATE_LIMIT_PER_IP_PER_MINUTE=60
MAX_QUESTION_LENGTH_CHARS=1000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://portal.university.edu
