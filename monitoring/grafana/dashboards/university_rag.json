{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "RAG Query Volume by Origin",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(rag_query_total[1m])) by (served_by)",
          "legendFormat": "{{served_by}}"
        }
      ]
    },
    {
      "title": "End-to-End Latency Quantiles",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "title": "Semantic Cache Hit Ratio",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(rag_cache_hits_total[5m])) / (sum(rate(rag_cache_hits_total[5m])) + sum(rate(rag_cache_misses_total[5m]))) * 100",
          "legendFormat": "Hit Ratio %"
        }
      ]
    },
    {
      "title": "Active Corpus Volume",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rag_documents_total",
          "legendFormat": "Documents"
        },
        {
          "expr": "rag_chunks_total",
          "legendFormat": "Chunks"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["rag", "university", "llm"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Enterprise University RAG - System Observability"
}
